# ===================================================================
# Webhook Reliability Lab - Environment Configuration Template
# Copy this file to .env and set your local credentials.
# ===================================================================

# Server Configuration
SERVER_PORT=8080

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=webhook_lab
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# Full JDBC URL Override (Optional - overrides DB_HOST/DB_PORT/DB_NAME when set)
# DB_URL=jdbc:mysql://localhost:3306/webhook_lab?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# JPA / Hibernate Configuration
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_min_32_characters_here
JWT_EXPIRATION_MS=86400000

